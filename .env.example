APP_ENV=development
PORT=8080

DATABASE_URL=postgres://mailtrack:mailtrack@localhost:5432/mailtrack?sslmode=disable

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

JWT_SECRET=change-me-to-a-long-random-string-in-production

TRACKING_DOMAIN=http://localhost:8080

# 32-byte base64-encoded key for AES-256-GCM token encryption
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

IP_HASH_SALT=change-me-random-salt

RATE_LIMIT_TRACKING_RPS=10
RATE_LIMIT_TRACKING_BURST=20

LOG_LEVEL=info
